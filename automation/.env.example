# Copy this file to automation/.env and fill the blank.
# Do not commit automation/.env. Do not paste the key into chat.
# If this file is missing, the runner uses the key in the YouTube automation/.env.

AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=ap-southeast-2

# Hooks, draft, and the rewrite pass. Override any of these.
MODEL_STORY=au.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_SCRIPT=amazon.nova-lite-v1:0
MODEL_LONGFORM=au.anthropic.claude-sonnet-4-6
MODEL_TITLE=amazon.nova-micro-v1:0

# Leave blank to use ~/.claude/linkedin/voice.md when it exists,
# and automation/voice.md otherwise.
VOICE_PATH=
